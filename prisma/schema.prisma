generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

model Guild {
  id        String @id
  name          String?
  rolls_channel String?
  insults   Boolean @default(true)

  users User[]

  sheetSets     RpgSheetSet[]
}

model User {
  id      String
  ficha   String?
  guildId String
  guild   Guild @relation(fields: [guildId], references: [id])

  @@id([id, guildId])
}

model RpgSheetSet {

  name     String

  cell     String

  dice     String?

  action  RpgSheetAction @default(get)

  guildId  String

  guild    Guild @relation(fields: [guildId],references: [id])

  @@id([name, guildId])
}

enum RpgSheetAction {
  get
  set
}