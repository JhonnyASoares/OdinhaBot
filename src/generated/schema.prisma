generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

model Guild {
  id            String  @id
  name          String?
  rolls_channel String?
  insults       Boolean @default(true)

  users User[]
}

model User {
  id    String  @id
  ficha String?

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([id, guildId])
}
